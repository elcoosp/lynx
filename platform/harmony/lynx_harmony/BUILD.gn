assert(is_harmony)

import("../../../core/Lynx.gni")
import("../../../core/base_targets.gni")
import("../harmony.gni")

source_set("native") {
  public_deps = [ "src/main/cpp" ]
}

if (enable_harmony_shared) {
  lynx_harmony_type = "shared_library"
} else {
  lynx_harmony_type = "source_set"
}

target(lynx_harmony_type, "lynx_harmony") {
  sources = [ "entry.cc" ]
  output_name = "lynx"

  public_deps = [
    ":native",
    "../../../base/platform/harmony:lynx_base",
    "../../../base/trace/native:trace",
    "../../../core:lynx_native",
    "../../../core/runtime/common/napi:napi_binding_quickjs",
    "../../../gfx:gfx",
    "../../../gfx/platform/harmony:lynx_gfx",
    "../../../service_api:lynx_service_api_native",
    "../../../third_party/quickjs",
    "../lynx_xelement",
  ]
  cflags = []
  libs = [ "deviceinfo_ndk.z" ]
  if (enable_primjs_prebuilt_lib) {
    lib_dirs = [ primjs_native_lib_dir ]
    libs += [
      "napi",
      "napi_adapter",
      "quick",
    ]
  } else {
    public_deps += [
      "../../../third_party/napi:adapter",
      "../../../third_party/napi:env",
      "../../../third_party/napi:napi_lib",
      "../../../third_party/napi:quickjs",
      "../../../third_party/quickjs:quickjs",
    ]
  }

  public_deps += [
    "../../../core/runtime/common/napi:napi_binding_jsvm",
    "../../../core/runtime/js/jsi/jsvm",
  ]

  if (enable_trace == "perfetto" || enable_trace == "systrace") {
    libs += [ "hitrace_ndk.z" ]
  }

  if (enable_testbench_replay) {
    public_deps += [ "../../../core/services/replay" ]
  }

  if (enable_testbench_recorder) {
    public_deps += [ "../../../core/services/recorder:recorder" ]
  }

  public_configs = [ ":harmony_public_config" ]
}

config("harmony_public_config") {
  defines = [
    "OS_HARMONY=1",
    "OS_POSIX=1",
  ]
}
